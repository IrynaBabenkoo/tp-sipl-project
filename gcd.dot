  n12 [label="gt_expr [3:8]\nM &gt; N", fillcolor="#E3F2FD"];
  n13 [label="var [3:8]\nM", fillcolor="#E3F2FD"];
  n14 [label="VAR\nM", fillcolor="#E8F5E9"];
  n13 -> n14;
  n12 -> n13;
  n15 [label="var [3:12]\nN", fillcolor="#E3F2FD"];
  n16 [label="VAR\nN", fillcolor="#E8F5E9"];
  n15 -> n16;
  n12 -> n15;
  n11 -> n12;
  n17 [label="assign [3:19]\nM := M - N", fillcolor="#E3F2FD"];
  n18 [label="VAR\nM", fillcolor="#E8F5E9"];
  n17 -> n18;
  n19 [label="sub [3:24]\nM - N", fillcolor="#E3F2FD"];
  n20 [label="var [3:24]\nM", fillcolor="#E3F2FD"];
  n21 [label="VAR\nM", fillcolor="#E8F5E9"];
  n20 -> n21;
  n19 -> n20;
  n22 [label="var [3:28]\nN", fillcolor="#E3F2FD"];
  n23 [label="VAR\nN", fillcolor="#E8F5E9"];
  n22 -> n23;
  n19 -> n22;
  n17 -> n19;
  n11 -> n17;
  n24 [label="assign [3:35]\nN := N - M", fillcolor="#E3F2FD"];
  n25 [label="VAR\nN", fillcolor="#E8F5E9"];
  n24 -> n25;
  n26 [label="sub [3:40]\nN - M", fillcolor="#E3F2FD"];
