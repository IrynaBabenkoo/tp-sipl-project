digraph ParseTree {
  node [shape=box, style="rounded,filled", fontname="Consolas", fontsize=10];
  n0 [label="start [1:1]\nbegin ...", fillcolor="#E3F2FD"];
  n1 [label="program [1:1]\nbegin ...", fillcolor="#E3F2FD"];
  n2 [label="while_stmt [2:3]\nwhile !(M = N) do ...", fillcolor="#E3F2FD"];
